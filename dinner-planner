  projectId: "dinner-planner-d0b29",
  storageBucket: "dinner-planner-d0b29.firebasestorage.app",
  messagingSenderId: "645973345088",
  appId: "1:645973345088:web:83e36574a707e41f1370a5"
};

// ===== Family =====
const PEOPLE = {
  jet: { name: "Jet", color: "var(--wed)" }, beckett: { name: "Beckett", color: "var(--tue)" }, isla: { name: "Isla", color: "var(--sat)" },
  greyson: { name: "Greyson", color: "var(--thu)" }, mom: { name: "Mom", color: "var(--sun)" }, dad: { name: "Dad", color: "var(--fri)" },
  family: { name: "Mom & Dad", color: "var(--mon)" }
