  for (const [q, u, name] of r.ing) ul.append(el("li", { text: q ? `${name}: ${fmtQty(q, u)}` : `${name} (pantry)` }));
  dt.append(ul, el("h4", { text: "Steps" }));
  const ol = el("ol"); for (const s of r.s) ol.append(el("li", { text: s }));
  dt.append(ol);
  if (r.note) dt.append(el("div", { class: "note", style: "margin-top:8px", text: r.note }));
  return dt;
}

// ===== Render: groceries =====
function buildList() {
  const map = new Map();
  for (const d of DAYS) {
    const r = getRecipe(nights[d.k].dish); if (!r) continue;
    for (const [qty, unit, name, a, flag] of r.ing) {
      const aisle = AISLE[a] || a || "Pantry";
      const k = (name + "|" + (aisle === "Pantry staples" ? "" : unit)).toLowerCase();
      if (!map.has(k)) map.set(k, { key: k, name, qty: 0, unit, aisle, flag, meals: new Set() });
      const it = map.get(k); it.qty += qty || 0; it.meals.add(r.n);
    }
  }
  return [...map.values()];
}
function renderList() {
  const items = buildList();
  const box = $("aisles"); box.replaceChildren();
  $("list-count").textContent = items.length ? `(${items.filter(i => !got[i.key]).length})` : "";
  if (!items.length) { box.append(el("p", { class: "fine", style: "font-size:1rem", text: "Nothing here yet. Pick some dinners and the list fills itself in." })); return; }
  const stores = [...new Set(items.map(storeFor))].sort((a, b) => (a === "costco") - (b === "costco"));
  for (const st of stores) {
  if (stores.length > 1) box.append(el("div", { class: "storehead", text: STORES[st].n }));
  for (const aisle of AISLE_ORDER) {
    const rows = items.filter(i => i.aisle === aisle && storeFor(i) === st).sort((a, b) => a.name.localeCompare(b.name));
    if (!rows.length) continue;
    const ul = el("ul", { class: "items" });
    for (const it of rows) {
      const id = "chk-" + it.key.replace(/[^a-z0-9]+/g, "-");
      const cb = el("input", { type: "checkbox", id }); cb.checked = !!got[it.key];
      cb.addEventListener("change", () => setGot(it.key, cb.checked));
      const lab = el("label", { for: id }, el("span", { class: "name", text: it.name }));
      if (aisle !== "Pantry staples" && it.qty) lab.append(" ", el("span", { class: "qty", text: "· " + fmtQty(it.qty, it.unit) }));
      lab.append(el("span", { class: "for", text: [...it.meals].join(", ") }));
      if (it.flag) lab.append(el("span", { class: "flag", text: it.flag }));
      const href = storeLink(st, it.name);
      ul.append(el("li", { class: "item" + (got[it.key] ? " done" : "") }, cb, lab, href ? el("a", { class: "amz", href, target: "_blank", rel: "noopener", text: "Check price" }) : el("span")));
    }
    box.append(el("div", { class: "aisle", style: `--ac:${AISLE_COLOR[aisle]}` }, el("h3", { text: aisle === "Pantry staples" ? "Pantry staples: tick what you have" : aisle }), ul));
  }
  }
}
function listText() {
  const items = buildList().filter(i => !got[i.key]);
  const lines = ["Dinner Planner groceries, week of " + fmtWeek(weekOf || mondayOf())];
  for (const st of [...new Set(items.map(storeFor))]) {
  lines.push("", "== " + STORES[st].n.toUpperCase() + " ==");
  for (const aisle of AISLE_ORDER) {
    const rows = items.filter(i => i.aisle === aisle && storeFor(i) === st); if (!rows.length) continue;
    lines.push("", aisle.toUpperCase());
    for (const i of rows) lines.push("- " + i.name + (aisle === "Pantry staples" || !i.qty ? "" : " (" + fmtQty(i.qty, i.unit) + ")") + (i.flag ? "  [check label]" : ""));
  }
  }
  return lines.join("\n");
}
function render() { renderWho(); renderWeek(); renderList(); renderCredits(); }
function renderCredits() {
  const ul = $("credits"); if (!ul) return; ul.replaceChildren();
  for (const r of RECIPES) { const wp = wikiPics[r.id]; if (!wp) continue; ul.append(el("li", {}, r.n + ": ", el("a", { href: wp.file, target: "_blank", rel: "noopener", text: `${wp.artist}, ${wp.license}` }))); }
  if (!ul.children.length) ul.append(el("li", { text: "Photos haven't loaded yet." }));
}
function renderWho() {
  const box = $("who"); box.replaceChildren(el("b", { text: "I'm" }));
  for (const k of ["dad", "mom", "greyson", "isla", "beckett", "jet"]) {
    box.append(el("button", { class: "pop", style: `--pc:${PEOPLE[k].color}`, "aria-pressed": String(me === k), text: PEOPLE[k].name, onclick: () => { me = k; try { localStorage.setItem("me", k); } catch (e) {} render(); } }));
  }
}
function askWho() { window.scrollTo({ top: 0, behavior: "smooth" }); toast("Tap your name first"); }

// ===== Saving (Firebase) =====
let famRef = null;
const FP = (...p) => new firebase.firestore.FieldPath(...p);
function fail() { toast("Couldn't save. Check your internet and try again."); }
function saveNight(k, patch) {
  nights = { ...nights, [k]: { ...nights[k], ...patch } };
  if (status === "ready" && "dish" in patch) status = "picking";
  render();
  if (famRef) famRef.update(FP("nights", k), nights[k], "status", status).catch(fail);
}
function setGot(k, v) {
  got = { ...got }; if (v) got[k] = true; else delete got[k]; renderList();
  if (famRef) famRef.update(FP("got", k), v ? true : firebase.firestore.FieldValue.delete()).catch(fail);
}
function saveStore() { if (famRef) famRef.update({ store, costcoBulk }).catch(fail); }
for (const [k, v] of Object.entries(STORES)) $("store").append(el("option", { value: k, text: v.n }));
const STORE_NOTE = {
  winco: "WinCo takes debit, cash and EBT, not credit cards. Skip the bulk bins for anything Greyson eats: nuts share the same scoops and bins. Vegan kimchi, rice cakes and glass noodles may need a stop at H Mart.",
  groceryoutlet: "Grocery Outlet stock changes weekly, so some items may not be there. Check dates on meat and read labels carefully.",
  costco: "Costco packs are large. Freeze extra meat in dinner-size bags the day you shop."
};
function syncStoreControls() { $("store").value = store; $("costco").checked = costcoBulk; $("costco").disabled = store === "costco"; const n = STORE_NOTE[store]; $("storenote").hidden = !n; $("storenote").textContent = n || ""; }
$("store").addEventListener("change", () => { store = $("store").value; syncStoreControls(); renderList(); saveStore(); });
$("costco").addEventListener("change", () => { costcoBulk = $("costco").checked; renderList(); saveStore(); });
syncStoreControls();

$("done").addEventListener("click", () => {
  status = "ready"; render();
  if (famRef) famRef.update({ status: "ready" }).catch(fail);
  toast("Week saved! The shopping list is ready.");
});
$("newweek").addEventListener("click", () => { $("confirm-new").hidden = false; });
$("confirm-no").addEventListener("click", () => { $("confirm-new").hidden = true; });
$("confirm-yes").addEventListener("click", () => {
  $("confirm-new").hidden = true;
  const stamp = new Date().toISOString();
  for (const d of DAYS) { const id = nights[d.k].dish; if (id && id !== "skip") history[id] = stamp; }
  nights = {}; ensureNights();
  status = "picking"; weekOf = mondayOf(new Date(Date.now() + 3 * 864e5)); got = {};
  render(); toast("New week started");
  if (famRef) famRef.update({ nights, status, weekOf, got: {}, history }).catch(fail);
});
$("reset").addEventListener("click", () => { got = {}; renderList(); if (famRef) famRef.update({ got: {} }).catch(fail); toast("Ticks cleared"); });
$("copy").addEventListener("click", () => {
  const text = listText();
  const fallback = () => { $("copy-fallback").hidden = false; $("copy-text").value = text; $("copy-text").select(); toast("Select all and copy"); };
  try { navigator.clipboard.writeText(text).then(() => toast("List copied"), fallback); } catch (e) { fallback(); }
});

// ===== Tabs =====
for (const b of document.querySelectorAll("nav.tabs button")) {
  b.addEventListener("click", () => {
    for (const x of document.querySelectorAll("nav.tabs button")) x.setAttribute("aria-selected", x === b ? "true" : "false");
    for (const v of ["plan", "list", "allergy"]) $("view-" + v).hidden = v !== b.dataset.view;
    try { localStorage.setItem("tab", b.dataset.view); } catch (e) {}
  });
}
try { const t = localStorage.getItem("tab"); if (t) document.querySelector(`nav.tabs button[data-view="${t}"]`)?.click(); } catch (e) {}

render();

// ===== Family link and live sync =====
function codeFromHash() { const h = location.hash.replace(/^#/, ""); return /^[A-Za-z0-9]{16,40}$/.test(h) ? h : null; }
let code = codeFromHash();
try { if (!code) code = localStorage.getItem("family"); } catch (e) {}
function shareLink() { return location.origin + location.pathname + "#" + code; }
function showApp(on) { $("setup").hidden = on; $("tabs").hidden = !on; for (const v of ["plan", "list", "allergy"]) if (!on) $("view-" + v).hidden = true; if (on) document.querySelector('nav.tabs button[aria-selected="true"]').click(); }
$("sharebtn").addEventListener("click", () => {
  const link = shareLink();
  const fallback = () => { $("sharetext").hidden = false; $("sharetext").value = link; $("sharetext").select(); toast("Select the link and copy it"); };
  try { navigator.clipboard.writeText(link).then(() => toast("Family link copied"), fallback); } catch (e) { fallback(); }
});
$("create").addEventListener("click", async () => {
  const bytes = crypto.getRandomValues(new Uint8Array(24));
  const abc = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789";
  const newCode = Array.from(bytes, x => abc[x % abc.length]).join("");
  $("create").disabled = true;
  try {
    nights = {}; ensureNights();
    await firebase.firestore().collection("families").doc(newCode).set({ nights, status: "picking", weekOf: mondayOf(), got: {}, history: {}, store: "winco", costcoBulk: true, created: new Date().toISOString() });
    location.hash = newCode; connect(newCode);
  } catch (e) { $("create").disabled = false; toast("Couldn't create the plan. Check the Firebase setup."); }
});
function connect(c) {
  code = c;
  try { localStorage.setItem("family", c); } catch (e) {}
  if (!codeFromHash()) window.history.replaceState(null, "", "#" + c);
  showApp(true); $("sharebox").hidden = false;
  famRef = firebase.firestore().collection("families").doc(c);
  famRef.onSnapshot({ includeMetadataChanges: true }, s => {
    if (!s.exists) { if (!s.metadata.fromCache) $("sync").textContent = "This family link doesn't work. Ask Dad for the right one."; return; }
    const v = s.data();
    nights = JSON.parse(JSON.stringify(v.nights || {})); ensureNights();
    status = v.status || "picking"; weekOf = v.weekOf || ""; got = { ...(v.got || {}) }; history = { ...(v.history || {}) };
    if (v.store && STORES[v.store]) store = v.store;
    if (typeof v.costcoBulk === "boolean") costcoBulk = v.costcoBulk;
    syncStoreControls(); render();
    $("sync").textContent = s.metadata.fromCache ? "Offline right now. Showing the last saved week." : "Saved for the whole family.";
  }, () => { $("sync").textContent = "Couldn't reach the family database."; });
}
loadPhotos();
(function start() {
  if (!window.firebase || !FIREBASE_CONFIG) { $("sync").textContent = "Not connected to the family database yet. Picks stay on this phone only."; return; }
  firebase.initializeApp(FIREBASE_CONFIG);
  try { firebase.firestore().enablePersistence({ synchronizeTabs: true }).catch(() => {}); } catch (e) {}
  if (code) connect(code); else { $("sync").textContent = ""; showApp(false); }
})();
</script>
</body>
</html>
